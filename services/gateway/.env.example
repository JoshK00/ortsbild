# Only needed to run the gateway on its own, outside docker compose (uvicorn --factory gateway.main:create_app --port 8080).
# In docker compose the gateway reads the env file of the backend (backend/.env, deploy/.env.prod): the names are the same.
# Copy to .env and fill in. Never commit .env.

# The backend, and the key that opens its entrance for the gateway (the same GATEWAY_KEY as in the backend's env file)
BACKEND_URL=http://localhost:8000
GATEWAY_KEY=

# The raw bucket of the backend (local: the S3 stand-in of backend/docker-compose.yml, any key works)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minio-local
STORAGE_SECRET_KEY=minio-local-secret
STORAGE_REGION=us-east-1
STORAGE_BUCKET_RAW=ortsbild-raw
