# Copy to .env and fill in. Never commit .env.

GATEWAY_TENANT=pilot
# JSON list. Empty list = no API key check (local development only).
GATEWAY_API_KEYS=["change-me"]

# Local: SQLite file. Supabase: use the connection string from Project Settings -> Database.
GATEWAY_DATABASE_URL=sqlite:///./gateway.db
# GATEWAY_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Local folder, or any S3-compatible storage (Supabase Storage S3 endpoint, MinIO, AWS).
GATEWAY_STORAGE_BACKEND=local
GATEWAY_STORAGE_LOCAL_ROOT=./data/storage
GATEWAY_STORAGE_BUCKET_ANONYMIZED=reports-anonymized
GATEWAY_STORAGE_BUCKET_RAW=reports-raw
# GATEWAY_STORAGE_BACKEND=s3
# GATEWAY_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# GATEWAY_S3_REGION=eu-central-1
# GATEWAY_S3_ACCESS_KEY_ID=
# GATEWAY_S3_SECRET_ACCESS_KEY=

# Email channel (only needed for the IMAP worker)
# GATEWAY_IMAP_HOST=imap.example.org
# GATEWAY_IMAP_PORT=993
# GATEWAY_IMAP_USERNAME=melden@example.org
# GATEWAY_IMAP_PASSWORD=
# GATEWAY_IMAP_POLL_INTERVAL_S=60
