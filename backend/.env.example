# Copy this file to backend/.env and fill in the values. .env is never committed.
# --- Database (PostgreSQL). Locally docker compose starts one, the URL below matches it.
DATABASE_URL=postgresql://ortsbild:ortsbild-local@localhost:5432/ortsbild

# --- Object storage (S3 compatible). Locally MinIO from docker compose, at IONOS the endpoint
# and the keys of the IONOS object storage (see deploy/.env.prod.example for the server).
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minio-local
STORAGE_SECRET_KEY=minio-local-secret
STORAGE_REGION=us-east-1
# Bucket names are unique per provider, choose your own
STORAGE_BUCKET_RAW=ortsbild-raw
STORAGE_BUCKET_CLEAN=ortsbild-clean

# Secret for hashing user identifiers before they are looked up (any long random string).
# Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Losing or changing it breaks the link between users and their pseudonyms.
PSEUDONYM_SECRET=

# Secret that signs the access tokens of the signed-in users (any long random string, at least 32 characters).
# Without it the API does not start. Changing it signs every user out.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# Key for the operator: with it /health shows the details of the checks. The app does not use it.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(24))"
API_KEY=

# Optional. Defaults: the bundle id of the app, the municipality of the reports, the limit per user and hour.
# CLASSIFICATION_PROVIDER=rules   (`rules` = the rule based stand-in, `anthropic` = Claude, needs ANTHROPIC_KEY)
# RESEARCH_PROVIDER=none   (`none` = no web research, the user adds the recipient; `anthropic` = Claude with its web search, needs ANTHROPIC_KEY)
# ANTHROPIC_KEY=       (the key of Anthropic, only in this file and in .env.prod, never in the app or in git)
# ANTHROPIC_CLASSIFICATION_MODEL=claude-haiku-5-5   (the default. More quality, more cost: claude-sonnet-5-5, claude-opus-5-5)
# ANTHROPIC_RESEARCH_MODEL=claude-haiku-5-5         (the default. For a harder place: claude-sonnet-5-5)
# APPLE_BUNDLE_ID=com.Joshua-Kehrer.Ortsbild
# TENANT_ID=pilot
# MAX_REPORTS_PER_HOUR=20
