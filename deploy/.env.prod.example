# Copy to ~/ortsbild/deploy/.env.prod ON THE SERVER and fill in the values. Never commit it.

# ":80" = plain HTTP on the IP (first tests). With a domain, put the domain here, e.g. api.example.com
SITE_ADDRESS=:80

# Password of the PostgreSQL container (any long random string, only used inside the server)
DATABASE_PASSWORD=

# IONOS object storage. Frankfurt = eu-central-4, Berlin = eu-central-3 (use your bucket's region)
STORAGE_ENDPOINT_URL=https://s3.eu-central-4.ionoscloud.com
STORAGE_REGION=eu-central-4
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Bucket names are unique across IONOS, so choose your own
STORAGE_BUCKET_RAW=
STORAGE_BUCKET_CLEAN=

# Key for the operator: with it /health shows the details of the checks. The app does not use it.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(24))"
API_KEY=

# Shared secret of the connector gateway and the backend: it opens the backend's entrance for the gateway
# (POST /internal/v1/reports). Without it that entrance does not exist and the gateway cannot hand reports over.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_KEY=

# Secret that signs the access tokens of the signed-in users (at least 32 characters). Without it the API does not start.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# NEW secret for the server, do not reuse the one of your dev machine.
# Create one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never change it afterwards, the pseudonyms of the reporters and the user keys depend on it.
PSEUDONYM_SECRET=


# Optional. Which model does the work (more in backend/.env.example). Without these lines the server runs on the simple fallbacks.
# CLASSIFICATION_PROVIDER=anthropic
# RESEARCH_PROVIDER=anthropic
# DRAFT_PROVIDER=anthropic
# ANTHROPIC_KEY=
# CLASSIFICATION_MIN_CONFIDENCE=0.6

# Optional. The public dashboard shows only the released reports of these reporter ids (comma separated). `*` shows everybody:
# right only while nobody but the team can sign in to the app, remove it before the app is public.
# DEMO_REPORTER_IDS=

# Optional. The privacy layer: the most faces it covers in one photo and the score from which a box counts as a face (0.1 to 0.95).
# MAX_FACES=10
# FACE_SCORE_THRESHOLD=0.7
# LOG_LEVEL=INFO
